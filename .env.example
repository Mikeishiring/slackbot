# Slack — get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Optional: restrict @-mention responses to specific channels (comma-separated IDs).
# DMs are always answered regardless of this setting. Omit to answer in any channel.
# SLACK_ALLOWED_CHANNELS=C0123456789,C9876543210

# Anthropic — get this from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-5

# Caps thinking + reply text together. Too low and answers truncate mid-sentence.
ANTHROPIC_MAX_TOKENS=16000

# Optional: adds your context to the end of the shipped system prompt.
# Good for one-liners. dotenv drops unquoted newlines, so anything longer than
# a sentence or two belongs in index.ts as `systemPromptAppend` instead.
# ANTHROPIC_SYSTEM_PROMPT_APPEND=You support the Acme billing team. Prices are in USD.

# How hard the model works before answering: low | medium | high | xhigh | max.
# `low` is fastest and cheapest and still answers most questions well; step up
# if replies feel shallow on harder questions.
ANTHROPIC_EFFORT=medium

# Per-attempt timeout. Generous on purpose — a thinking model plus a few tool
# calls can legitimately take a while.
ANTHROPIC_REQUEST_TIMEOUT_MS=120000
ANTHROPIC_MAX_RETRIES=2
